# ---------------------------------------------------------------
# Base de datos (elegir UNA línea)
# ---------------------------------------------------------------
# Opción A (la más simple, no requiere instalar nada): SQLite
DATABASE_URL=sqlite:///./foodstore.db
# Opción B: PostgreSQL 15+ (crear antes la base: CREATE DATABASE foodstore_db;)
# DATABASE_URL=postgresql://postgres:TU_PASSWORD@localhost:5432/foodstore_db

# Firma del JWT: mínimo 32 caracteres
SECRET_KEY=cambiar-esta-clave-de-al-menos-32-caracteres
ALGORITHM=HS256
# Expiración de la cookie y del token (minutos)
ACCESS_TOKEN_EXPIRE_MINUTES=30
# Origen permitido en CORS: debe coincidir EXACTO con la URL del frontend
FRONTEND_ORIGIN=http://localhost:5173
# true solo en producción con HTTPS (cookie Secure)
COOKIE_SECURE=false
